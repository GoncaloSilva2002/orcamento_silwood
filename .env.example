PORT=3000
HOST=0.0.0.0

# Supabase Auth. When both values are present, login uses Supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret used to create and manage users from the app.
# Never expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local fallback used only when Supabase is not configured.
SILWOOD_ADMIN_USER=admin
SILWOOD_ADMIN_PASSWORD=silwood

# Temporary first-admin login while setting up Supabase users from the app.
# Turn this off after creating a real admin user in Supabase.
SILWOOD_BOOTSTRAP_ADMIN=false
